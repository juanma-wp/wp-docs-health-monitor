# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out-*/
*.tsbuildinfo

# Generated dashboard output — ignore everything under out/ except the
# token-paid source-of-truth artifacts. Every other file (HTML, the
# meta-index sites.json, data/history.json) is derived and rebuilt from
# these via scripts/rebuild.ts in CI.
out/**
!out/
!out/*/
!out/*/data/
!out/*/data/site.json
!out/*/data/runs/
!out/*/data/runs/*/
!out/*/data/runs/*/results.json

# Environment / secrets
.env
.env.local
.env.*.local

# Runtime state / caches
.cache/
.tmp/
tmp/
/tmp-*/
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Project-specific
/analysis-output/
/.gutenberg-clone/
/results-*.json

# Local config overrides (dev settings, not committed)
config/*.dev.json

CLAUDE.local.md

# Agent runtime state — auto-created worktrees from agent isolation runs
.claude/worktrees/
.claude/skills/*
!.claude/skills/triage/
!.claude/skills/grill-me/
!.claude/skills/grill-with-docs/
!.claude/skills/to-issues/
!.claude/skills/to-prd/

# Sandcastle runtime state (logs, worktrees, sessions, local env)
.sandcastle/.env
.sandcastle/worktrees/
.sandcastle/logs/
.sandcastle/sessions/
.sandcastle/.cache/
