{
  "project": {
    "name": "Gutenberg Block Editor Handbook"
  },
  "docSource": {
    "type": "manifest-url",
    "manifestUrl": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/docs/manifest.json",
    "parentSlug": "*",
    "sourceUrlBase": "https://developer.wordpress.org/block-editor/",
    "ignore": {
      "subtrees": ["packages", "components", "contributors", "data", "explanations", "devenv"],
      "slugs": [
        "handbook",
        "getting-started",
        "reference-guides",
        "block-api",
        "core-blocks",
        "filters",
        "theme-json-reference",
        "block-tutorial",
        "platform",
        "data-basics",
        "curating-the-editor-experience",
        "themes",
        "widgets",
        "accessibility",
        "quick-start-guide",
        "glossary",
        "faq",
        "core-concepts",
        "iapi-quick-start-guide"
      ]
    }
  },
  "codeSources": {
    "gutenberg": {
      "type": "git-clone",
      "repoUrl": "https://github.com/WordPress/gutenberg.git",
      "ref": "trunk"
    },
    "wordpress-develop": {
      "type": "git-clone",
      "repoUrl": "https://github.com/WordPress/wordpress-develop.git",
      "ref": "7.0"
    }
  },
  "mappingPath": "mappings/gutenberg-block-editor.json",
  "outputDir": "./out",
  "validator": {
    "type": "claude",
    "pass1Model": "claude-sonnet-4-6",
    "pass2Model": "claude-sonnet-4-6",
    "systemPromptExtension": "prompts/gutenberg-block-editor.md"
  }
}
